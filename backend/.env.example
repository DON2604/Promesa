# NeedMesh API configuration. Copy to backend/.env. Never commit real credentials.
# Defaults are safe: sandbox, deterministic fixture LLM, no live PayPal writes.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://promesa:promesa@127.0.0.1:5432/promesa?connection_limit=10&pool_timeout=20
# Optional in Phase 1 (workers arrive in Phase 2). Leave empty to skip the readiness probe.
REDIS_URL=
# >= 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=replace-with-a-strong-random-secret-of-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# PayPal (server-side only). Placeholders are treated as "not configured".
# Without credentials NeedMesh runs a clearly labelled SIMULATED rail. With credentials AND
# ENABLE_LIVE_PAYPAL_WRITES=true it makes real PayPal Sandbox calls (orders, authorize, capture, void, refund).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_MERCHANT_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_MERCHANT_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_REGISTERED_SANDBOX_WEBHOOK_ID
# Official @paypal/mcp over stdio, read-only get_order for the Recovery Agent.
PAYPAL_MCP_ENABLED=false
PAYPAL_MCP_MODE=local
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/mcp
PAYPAL_MCP_ALLOWED_TOOLS=
ENABLE_LIVE_PAYPAL_WRITES=false

# LLM provider for mission narration: fixture (deterministic, offline) | openai | gemini. (anthropic is not implemented.)
# Narration never decides money; its figures are checked against the planner.
LLM_PROVIDER=fixture
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Channel3 product discovery (planned adapter; presence is reported, no calls are made yet)
CHANNEL3_API_KEY=
GEMINI_API_KEY=
CHANNEL3_API_KEY=

# Evidence object storage (Phase 3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=promesa-evidence
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key

# Demo mode: labelled fixtures, simulated scenario clock and the demo identity provider.
# Startup refuses NODE_ENV=production while either is enabled.
DEMO_MODE=true
DEMO_AUTH_ENABLED=true

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
