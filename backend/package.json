{
  "name": "@promesa/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Promesa API — NestJS/Fastify modular monolith for NeedMesh missions and PromiseTwin.",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@paypal/mcp": "^1.8.1",
    "@prisma/client": "6.19.3",
    "@promesa/contracts": "0.1.0",
    "fastify": "^5.6.1",
    "pino": "^9.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.1",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "vitest": "3.2.7"
  }
}
